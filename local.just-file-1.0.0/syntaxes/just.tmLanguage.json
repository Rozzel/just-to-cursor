{
	"name": "Just",
	"scopeName": "source.just",
	"fileTypes": ["just", "justfile", "Justfile"],
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#import" },
		{ "include": "#module" },
		{ "include": "#alias" },
		{ "include": "#assignment" },
		{ "include": "#attribute" },
		{ "include": "#recipes" },
		{ "include": "#builtins" },
		{ "include": "#keywords" },
		{ "include": "#expression-operators" },
		{ "include": "#strings" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.number-sign.shebang.just",
					"match": "^#![ \\t]*/.*just\\b.*$"
				},
				{
					"name": "comment.line.number-sign.just",
					"match": "#(?!!).*$"
				}
			]
		},
		"import": {
			"begin": "^(import)(\\?)?[ \\t]+",
			"end": "$",
			"beginCaptures": {
				"1": { "name": "keyword.other.reserved.just" },
				"2": { "name": "punctuation.optional.just" }
			},
			"patterns": [
				{ "include": "#strings" }
			]
		},
		"module": {
			"begin": "^(mod)(\\?)?[ \\t]+([A-Za-z_][A-Za-z0-9_-]*)",
			"end": "$",
			"beginCaptures": {
				"1": { "name": "keyword.other.reserved.just" },
				"2": { "name": "punctuation.optional.just" },
				"3": { "name": "variable.name.module.just" }
			},
			"patterns": [
				{ "include": "#strings" }
			]
		},
		"alias": {
			"match": "^(alias)[ \\t]+([A-Za-z_][A-Za-z0-9_-]*)[ \\t]*(:=)[ \\t]*([A-Za-z_][A-Za-z0-9_-]*)",
			"captures": {
				"1": { "name": "keyword.other.reserved.just" },
				"2": { "name": "variable.name.alias.just" },
				"3": { "name": "keyword.operator.assignment.just" },
				"4": { "name": "variable.other.just" }
			}
		},
		"assignment": {
			"patterns": [
				{
					"match": "^(unexport)[ \\t]+([A-Za-z_][A-Za-z0-9_-]*)",
					"captures": {
						"1": { "name": "keyword.other.reserved.just" },
						"2": { "name": "variable.other.just" }
					}
				},
				{
					"begin": "^((?:export)[ \\t]+)?([A-Za-z_][A-Za-z0-9_-]*)[ \\t]*(:=)",
					"end": "$",
					"beginCaptures": {
						"1": { "name": "keyword.other.reserved.just" },
						"2": { "name": "variable.other.just" },
						"3": { "name": "keyword.operator.assignment.just" }
					},
					"patterns": [
						{ "include": "#expression" },
						{ "include": "#comments" }
					]
				},
				{
					"begin": "^(set)[ \\t]+([A-Za-z_][A-Za-z0-9_-]*)[ \\t]*(:=)?",
					"end": "$",
					"beginCaptures": {
						"1": { "name": "keyword.other.reserved.just" },
						"2": { "name": "variable.other.just" },
						"3": { "name": "keyword.operator.assignment.just" }
					},
					"patterns": [
						{ "include": "#expression" },
						{ "include": "#comments" }
					]
				}
			]
		},
		"attribute": {
			"match": "^(\\[)([^\\]]+)(\\])",
			"captures": {
				"1": { "name": "support.function.system.just" },
				"2": { "name": "support.function.system.just" },
				"3": { "name": "keyword.operator.attribute.end.just" }
			}
		},
		"recipes": {
			"begin": "^(@)?([A-Za-z_][A-Za-z0-9_-]*)(?=[^\\n]*:[^=])",
			"end": "^(?=\\S)",
			"beginCaptures": {
				"1": { "name": "keyword.operator.quiet.just" },
				"2": { "name": "entity.name.function.just" }
			},
			"patterns": [
				{
					"match": ":",
					"name": "keyword.operator.recipe.end.just"
				},
				{ "include": "#recipe-params" },
				{ "include": "#strings" },
				{ "include": "#comments" },
				{ "include": "#recipe-body" }
			]
		},
		"recipe-params": {
			"patterns": [
				{
					"match": "(\\+)([A-Za-z_][A-Za-z0-9_-]*)",
					"captures": {
						"1": { "name": "keyword.other.recipe.variadic.just" },
						"2": { "name": "variable.parameter.recipe.just" }
					}
				},
				{
					"match": "([A-Za-z_][A-Za-z0-9_-]*)[ \\t]*(=)",
					"captures": {
						"1": { "name": "variable.parameter.recipe.just" },
						"2": { "name": "keyword.operator.default.just" }
					}
				},
				{
					"match": "(?<=\\s)([A-Za-z_][A-Za-z0-9_-]*)(?=\\s|:)",
					"name": "variable.parameter.recipe.just"
				}
			]
		},
		"recipe-body": {
			"patterns": [
				{
					"match": "^[ \\t]+(@)",
					"captures": {
						"1": { "name": "keyword.operator.quiet.just" }
					}
				},
				{
					"match": "^[ \\t]+(-)",
					"captures": {
						"1": { "name": "keyword.operator.error-suppression.just" }
					}
				},
				{ "include": "#interpolation" },
				{ "include": "#strings" },
				{ "include": "#comments" }
			]
		},
		"expression": {
			"patterns": [
				{ "include": "#builtins" },
				{ "include": "#keywords" },
				{ "include": "#expression-operators" },
				{ "include": "#strings" },
				{ "include": "#interpolation" },
				{
					"begin": "\\(",
					"end": "\\)",
					"patterns": [
						{ "include": "#expression" }
					]
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.conditional.just",
					"match": "\\b(if|else)\\b"
				},
				{
					"name": "keyword.other.reserved.just",
					"match": "\\b(import|mod|alias|set|export|unexport)\\b"
				}
			]
		},
		"expression-operators": {
			"patterns": [
				{
					"name": "keyword.operator.assignment.just",
					"match": ":="
				},
				{
					"name": "keyword.operator.path-join.just",
					"match": "/"
				},
				{
					"name": "keyword.operator.concat.just",
					"match": "\\+"
				},
				{
					"name": "keyword.operator.and.just",
					"match": "&&"
				},
				{
					"name": "keyword.operator.or.just",
					"match": "\\|\\|"
				},
				{
					"name": "keyword.operator.equality.just",
					"match": "==|!=|=~"
				}
			]
		},
		"builtins": {
			"patterns": [
				{
					"name": "constant.language.const.just",
					"match": "\\b(HEX|HEXLOWER|HEXUPPER|PATH_SEP|PATH_VAR_SEP|CLEAR|NORMAL|BOLD|ITALIC|UNDERLINE|INVERT|HIDE|STRIKETHROUGH|BLACK|RED|GREEN|YELLOW|BLUE|MAGENTA|CYAN|WHITE)\\b"
				},
				{
					"name": "support.function.builtin.just",
					"match": "\\b(arch|num_cpus|os|os_family|shell|env_var|env_var_or_default|env|is_dependency|invocation_directory|invocation_dir|invocation_directory_native|invocation_dir_native|justfile|justfile_directory|justfile_dir|just_executable|just_pid|source_file|source_directory|source_dir|module_file|module_directory|module_dir|append|prepend|encode_uri_component|quote|replace|replace_regex|trim|trim_end|trim_end_match|trim_end_matches|trim_start|trim_start_match|trim_start_matches|capitalize|kebabcase|lowercamelcase|lowercase|shoutykebabcase|shoutysnakecase|snakecase|titlecase|uppercamelcase|uppercase|absolute_path|blake3|blake3_file|canonicalize|extension|file_name|file_stem|parent_directory|parent_dir|without_extension|clean|join|path_exists|error|assert|sha256|sha256_file|uuid|choose|datetime|datetime_utc|semver_matches|style|cache_directory|cache_dir|config_directory|config_dir|config_local_directory|config_local_dir|data_directory|data_dir|data_local_directory|data_local_dir|executable_directory|executable_dir|home_directory|home_dir|which|require|read)\\b"
				},
				{
					"name": "constant.language.boolean.just",
					"match": "\\b(true|false)\\b"
				},
				{
					"name": "constant.numeric.just",
					"match": "\\b[0-9]+\\b"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.just",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.just",
							"match": "\\\\."
						},
						{ "include": "#interpolation" }
					]
				},
				{
					"name": "string.quoted.single.just",
					"begin": "'",
					"end": "'",
					"patterns": [
						{ "include": "#interpolation" }
					]
				},
				{
					"name": "string.quoted.double.indented.just",
					"begin": "\"\"\"",
					"end": "\"\"\"",
					"patterns": [
						{
							"name": "constant.character.escape.just",
							"match": "\\\\."
						},
						{ "include": "#interpolation" }
					]
				},
				{
					"name": "string.quoted.single.indented.just",
					"begin": "'''",
					"end": "'''",
					"patterns": [
						{ "include": "#interpolation" }
					]
				}
			]
		},
		"interpolation": {
			"patterns": [
				{
					"name": "string.interpolated.just",
					"begin": "\\{\\{",
					"end": "\\}\\}",
					"patterns": [
						{ "include": "#expression" }
					]
				}
			]
		}
	}
}
